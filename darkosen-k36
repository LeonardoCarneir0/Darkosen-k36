#!/usr/bin/env bash
# Unified project launcher for darkosen-k36 (uses local .venv if present, falls back to python3)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "${SCRIPT_DIR}/.venv/bin/darkosen-k36" ]; then
    exec "${SCRIPT_DIR}/.venv/bin/darkosen-k36" "$@"
else
    exec python3 "${SCRIPT_DIR}/darkosen_k36.py" "$@"
fi
